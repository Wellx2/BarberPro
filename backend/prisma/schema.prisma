generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  // URL NO CONFIG [web:169]
}

model User {
  id        String   @id @default(cuid())
  name      String
  email     String   @unique
  createdAt DateTime @default(now())
  shops     Shop[]
}

model Shop {
  id        String    @id @default(cuid())
  name      String
  cnpj      String    @unique
  ownerId   String
  owner     User      @relation(fields: [ownerId], references: [id])
  products  Product[]
  createdAt DateTime  @default(now())
}

model Product {
  id        String   @id @default(cuid())
  name      String
  price     Float
  stock     Int      @default(0)
  shopId    String
  shop      Shop     @relation(fields: [shopId], references: [id])
  createdAt DateTime @default(now())
}
