generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Barbershop {
  id                     String                    @id @default(uuid())
  name                   String
  cnpj                   String?                   @unique
  phone                  String
  address                String?
  logo                   String?
  openingTime            String                    @default("09:00")
  closingTime            String                    @default("20:00")
  intervalMinutes        Int                       @default(30)
  loyaltyEnabled         Boolean                   @default(true)
  subscriptionEnabled    Boolean                   @default(true)
  createdAt              DateTime                  @default(now())
  updatedAt              DateTime                  @updatedAt
  active                 Boolean                   @default(true)
  vipBannerText          String                    @default("Assine qualquer plano e ganhe até 40% de desconto em todos os produtos")
  vipBannerTitle         String                    @default("Benefício de Assinante")
  maxTeamMembers         Int?                      @default(3)
  modulesEnabled         Json?
  subscriptionEndDate    DateTime?
  subscriptionStartDate  DateTime?
  subscriptionStatus     SubscriptionStatus?       @default(ACTIVE)
  subscriptionTier       SubscriptionTier?         @default(BASIC)
  bannerUrl              String?
  logoUrl                String?
  primaryColor           String?                   @default("#f59e0b")
  email                  String?
  whatsapp               String?
  settings               Json?                     @default("{}")
  socialGoogleReview     String?
  socialInstagram        String?
  socialWhatsapp         String?
  slug                   String?                   @unique
  agendaLocks            AgendaLock[]
  appointments           Appointment[]
  barberCommissions      BarberCommission[]
  barbers                Barber[]
  faqs                   BarbershopFaq[]
  heroSettings           BarbershopHeroSettings?
  modules                BarbershopModule[]
  plansContent           BarbershopPlansContent?
  assets                 BarbershopAsset[]
  blockedTimes           BlockedTime[]
  clients                Client[]
  dailyCashFlow          DailyCashFlow[]
  expenses               Expense[]
  favoritedBy            FavoriteBarbershop[]
  fixedCosts             FixedCost[]
  invoices               Invoice[]
  notificationLogs       NotificationLog[]
  stockMovements         ProductStockMovement[]
  products               Product[]
  serviceDisabledPeriods ServiceDisabledPeriod[]
  serviceOrders          ServiceOrder[]
  analytics              ServiceProductAnalytics[]
  services               Service[]
  supplyItems            SupplyItem[]
  usersWithAccess        UserShopAccess[]
  users                  User[]

  @@map("barbershops")
}

model User {
  id                  String                 @id @default(uuid())
  name                String
  email               String?                @unique
  phone               String?
  passwordHash        String?
  role                UserRole               @default(CLIENT)
  shopId              String?
  planId              String?
  credits             Int?                   @default(0)
  active              Boolean                @default(true)
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  refreshToken        String?
  avatar              String?
  emailVerified       Boolean                @default(false)
  provider            AuthProvider           @default(LOCAL)
  providerId          String?
  resetToken          String?
  resetTokenExpires   DateTime?
  globalPushEnabled   Boolean                @default(true)
  agendaLocks         AgendaLock[]           @relation("AgendaLockCreator")
  createdAppointments Appointment[]          @relation("CreatedAppointments")
  barberProfile       Barber?                @relation("UserBarberProfile")
  clientProfile       Client?                @relation("UserClientProfile")
  stockMovements      ProductStockMovement[]
  shopAccess          UserShopAccess[]
  plan                Plan?                  @relation(fields: [planId], references: [id])
  shop                Barbershop?            @relation(fields: [shopId], references: [id])

  @@unique([provider, providerId])
  @@map("users")
}

model Barber {
  id               String             @id @default(uuid())
  shopId           String
  name             String
  nickname         String?
  description      String?
  specialties      String[]
  rating           Float              @default(0)
  avatar           String?
  experienceYears  Int?
  services         String[]           @default([])
  active           Boolean            @default(true)
  workModel        BarberWorkModel    @default(COMMISSION_ONLY)
  monthlySalary    Float?
  chairRentalFee   Float?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  bio              String?
  birthDate        DateTime?
  commissionRate   Float?
  email            String?
  hireDate         DateTime?
  phone            String?
  role             TeamMemberRole     @default(BARBER)
  userId           String?            @unique
  iCalToken        String?            @unique @default(uuid())
  balance          Float              @default(0)
  agendaLocks      AgendaLock[]       @relation("AgendaLocks")
  appointments     Appointment[]
  commissions      BarberCommission[]
  shop             Barbershop         @relation(fields: [shopId], references: [id])
  user             User?              @relation("UserBarberProfile", fields: [userId], references: [id])
  blockedTimes     BlockedTime[]
  invoices         Invoice[]
  notificationLogs NotificationLog[]
  reviews          Review[]
  serviceOrders    ServiceOrder[]

  @@index([shopId])
  @@index([userId])
  @@index([shopId, active])
  @@map("barbers")
}

model Service {
  id              String                    @id @default(uuid())
  shopId          String
  name            String
  duration        Int
  price           Float
  category        String
  description     String?
  active          Boolean                   @default(true)
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt
  image           String?
  featured        Boolean                   @default(false)
  deletedAt       DateTime?
  supplyCost      Float                     @default(0)
  appointments    AppointmentService[]
  commissions     BarberCommission[]
  invoiceItems    InvoiceItem[]
  orderItems      OrderItem[]
  disabledPeriods ServiceDisabledPeriod[]
  analytics       ServiceProductAnalytics[]
  shop            Barbershop                @relation(fields: [shopId], references: [id])

  @@index([shopId])
  @@map("services")
}

model ServiceDisabledPeriod {
  id        String              @id @default(uuid())
  serviceId String
  shopId    String
  type      ServiceDisabledType
  date      DateTime?
  startDate DateTime?
  endDate   DateTime?
  reason    String
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
  service   Service             @relation(fields: [serviceId], references: [id])
  shop      Barbershop          @relation(fields: [shopId], references: [id])

  @@index([serviceId])
  @@index([shopId])
  @@map("service_disabled_periods")
}

model Product {
  id             String                    @id @default(uuid())
  shopId         String
  name           String
  price          Float
  stock          Int
  category       String?
  description    String?
  image          String?
  active         Boolean                   @default(true)
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt
  costPrice      Float?
  unit           String?
  formulation    String?
  howToUse       String?
  recommendedFor String?
  featured       Boolean                   @default(false)
  deletedAt      DateTime?
  appointments   AppointmentProduct[]
  commissions    BarberCommission[]
  invoiceItems   InvoiceItem[]
  orderItems     OrderItem[]
  stockMovements ProductStockMovement[]
  shop           Barbershop                @relation(fields: [shopId], references: [id])
  analytics      ServiceProductAnalytics[]

  @@index([shopId])
  @@map("products")
}

model Client {
  id               String               @id @default(uuid())
  shopId           String
  name             String
  nickname         String?
  birthDate        DateTime?
  phone            String
  cpf              String?              @unique
  email            String?
  active           Boolean              @default(true)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  userId           String?              @unique
  addresses        Address[]
  appointments     Appointment[]        @relation("ClientAppointments")
  shop             Barbershop           @relation(fields: [shopId], references: [id])
  user             User?                @relation("UserClientProfile", fields: [userId], references: [id])
  favorites        FavoriteBarbershop[]
  invoices         Invoice[]
  notificationLogs NotificationLog[]
  reviews          Review[]
  serviceOrders    ServiceOrder[]

  @@index([shopId])
  @@index([userId])
  @@map("clients")
}

model Address {
  id         String   @id @default(uuid())
  clientId   String
  cep        String
  street     String
  number     String
  complement String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  client     Client   @relation(fields: [clientId], references: [id])

  @@index([clientId])
  @@map("addresses")
}

model FavoriteBarbershop {
  id           String     @id @default(uuid())
  clientId     String
  barbershopId String
  createdAt    DateTime   @default(now())
  barbershop   Barbershop @relation(fields: [barbershopId], references: [id])
  client       Client     @relation(fields: [clientId], references: [id])

  @@unique([clientId, barbershopId])
  @@index([clientId])
  @@index([barbershopId])
  @@map("favorite_barbershops")
}

model Appointment {
  id               String               @id @default(uuid())
  shopId           String
  clientId         String
  barberId         String
  date             DateTime
  status           AppointmentStatus    @default(SCHEDULED)
  totalPrice       Float
  cancelReason     String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  cancelledAt      DateTime?
  cancelledBy      String?
  createdBy        String
  deletedAt        DateTime?
  deletedBy        String?
  notes            String?
  totalDuration    Int                  @default(0)
  updatedBy        String?
  reminderEnabled  Boolean              @default(true)
  products         AppointmentProduct[]
  services         AppointmentService[]
  barber           Barber               @relation(fields: [barberId], references: [id])
  client           Client               @relation("ClientAppointments", fields: [clientId], references: [id])
  creator          User                 @relation("CreatedAppointments", fields: [createdBy], references: [id])
  shop             Barbershop           @relation(fields: [shopId], references: [id])
  invoice          Invoice?
  notificationLogs NotificationLog[]
  review           Review?
  serviceOrder     ServiceOrder?

  @@index([shopId, barberId, date])
  @@index([clientId])
  @@index([createdBy])
  @@index([status])
  @@map("appointments")
}

model AppointmentService {
  id            String      @id @default(uuid())
  appointmentId String
  serviceId     String
  appointment   Appointment @relation(fields: [appointmentId], references: [id])
  service       Service     @relation(fields: [serviceId], references: [id])

  @@unique([appointmentId, serviceId])
  @@map("appointment_services")
}

model AppointmentProduct {
  id            String      @id @default(uuid())
  appointmentId String
  productId     String
  name          String
  price         Float
  quantity      Int
  appointment   Appointment @relation(fields: [appointmentId], references: [id])
  product       Product     @relation(fields: [productId], references: [id])

  @@unique([appointmentId, productId])
  @@map("appointment_products")
}

model BlockedTime {
  id        String      @id @default(uuid())
  shopId    String
  barberId  String
  date      DateTime
  endDate   DateTime?
  type      BlockedType
  startTime String?
  endTime   String?
  reason    String?
  blockedBy BlockedBy   @default(BARBER)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  barber    Barber      @relation(fields: [barberId], references: [id])
  shop      Barbershop  @relation(fields: [shopId], references: [id])

  @@index([shopId, barberId, date])
  @@map("blocked_times")
}

model AgendaLock {
  id              String     @id @default(uuid())
  shopId          String
  teamMemberId    String
  date            DateTime
  startTime       String
  endTime         String
  reason          String
  lockedBy        String
  forceOverride   Boolean    @default(false)
  notifiedClients String[]   @default([])
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  lockedByUser    User       @relation("AgendaLockCreator", fields: [lockedBy], references: [id])
  shop            Barbershop @relation(fields: [shopId], references: [id])
  barber          Barber     @relation("AgendaLocks", fields: [teamMemberId], references: [id])

  @@index([shopId, teamMemberId, date])
  @@index([teamMemberId, date])
  @@map("agenda_locks")
}

model Plan {
  id               String        @id @default(uuid())
  name             String
  price            Float
  benefits         String[]
  discount         Float         @default(0)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  active           Boolean       @default(true)
  benefitMoneyback Float?        @default(0)
  benefitMonths    Int?          @default(1)
  benefitProducts  Int?          @default(0)
  benefitServices  Int?          @default(0)
  description      String?
  isPopular        Boolean       @default(false)
  shopId           String?
  invoiceItems     InvoiceItem[]
  users            User[]

  @@map("plans")
}

model Review {
  id            String       @id @default(uuid())
  appointmentId String?      @unique
  barberId      String?
  clientId      String?
  rating        Int
  comment       String
  date          DateTime     @default(now())
  client        Client?      @relation(fields: [clientId], references: [id], map: "review_client_fkey")
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])
  barber        Barber?      @relation(fields: [barberId], references: [id])

  @@index([barberId])
  @@index([clientId])
  @@map("reviews")
}

model AuditLog {
  id        String   @id @default(uuid())
  action    String
  entity    String
  entityId  String
  userId    String?
  shopId    String?
  timestamp DateTime @default(now())
  details   String?

  @@index([shopId])
  @@index([userId])
  @@map("audit_logs")
}

model ProductStockMovement {
  id        String                   @id @default(uuid())
  productId String
  shopId    String
  type      ProductStockMovementType
  quantity  Int
  reason    String?
  createdAt DateTime                 @default(now())
  userId    String?
  product   Product                  @relation(fields: [productId], references: [id])
  shop      Barbershop               @relation(fields: [shopId], references: [id])
  user      User?                    @relation(fields: [userId], references: [id])

  @@index([productId])
  @@index([shopId])
  @@index([userId])
  @@map("product_stock_movements")
}

model ServiceOrder {
  id            String         @id @default(uuid())
  shopId        String
  clientId      String
  barberId      String
  appointmentId String?        @unique
  orderNumber   Int
  status        OrderStatus    @default(OPEN)
  subtotal      Float          @default(0)
  discount      Float          @default(0)
  total         Float          @default(0)
  paymentMethod PaymentMethod?
  paidAt        DateTime?
  notes         String?
  startedAt     DateTime       @default(now())
  completedAt   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  items         OrderItem[]
  appointment   Appointment?   @relation(fields: [appointmentId], references: [id])
  barber        Barber         @relation(fields: [barberId], references: [id])
  client        Client         @relation(fields: [clientId], references: [id])
  shop          Barbershop     @relation(fields: [shopId], references: [id])

  @@unique([shopId, orderNumber])
  @@index([shopId, createdAt])
  @@index([clientId])
  @@index([barberId])
  @@index([status])
  @@map("service_orders")
}

model OrderItem {
  id              String        @id @default(uuid())
  orderId         String
  type            OrderItemType
  serviceId       String?
  productId       String?
  name            String
  description     String?
  quantity        Int           @default(1)
  unitPrice       Float
  total           Float
  commissionRate  Float?
  commissionValue Float?
  createdAt       DateTime      @default(now())
  order           ServiceOrder  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product         Product?      @relation(fields: [productId], references: [id])
  service         Service?      @relation(fields: [serviceId], references: [id])

  @@index([orderId])
  @@index([serviceId])
  @@index([productId])
  @@map("order_items")
}

model BarberCommission {
  id              String         @id @default(uuid())
  shopId          String
  barberId        String
  serviceId       String?
  productId       String?
  type            CommissionType @default(PERCENTAGE)
  value           Float
  minTarget       Float?
  maxTarget       Float?
  applyOnServices Boolean        @default(true)
  applyOnProducts Boolean        @default(false)
  active          Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  barber          Barber         @relation(fields: [barberId], references: [id])
  product         Product?       @relation(fields: [productId], references: [id])
  service         Service?       @relation(fields: [serviceId], references: [id])
  shop            Barbershop     @relation(fields: [shopId], references: [id])

  @@index([shopId])
  @@index([barberId])
  @@index([serviceId])
  @@index([productId])
  @@map("barber_commissions")
}

model Expense {
  id            String         @id @default(uuid())
  shopId        String
  type          ExpenseType
  category      String
  description   String
  amount        Float
  isRecurring   Boolean        @default(false)
  recurrenceDay Int?
  dueDate       DateTime
  paidDate      DateTime?
  isPaid        Boolean        @default(false)
  paymentMethod PaymentMethod?
  notes         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  shop          Barbershop     @relation(fields: [shopId], references: [id])

  @@index([shopId, dueDate])
  @@index([type])
  @@index([isPaid])
  @@map("expenses")
}

model DailyCashFlow {
  id                String     @id @default(uuid())
  shopId            String
  date              DateTime   @db.Date
  totalRevenue      Float      @default(0)
  servicesRevenue   Float      @default(0)
  productsRevenue   Float      @default(0)
  totalDiscounts    Float      @default(0)
  totalExpenses     Float      @default(0)
  totalCommissions  Float      @default(0)
  netRevenue        Float      @default(0)
  profit            Float      @default(0)
  totalOrders       Int        @default(0)
  totalAppointments Int        @default(0)
  averageTicket     Float      @default(0)
  cashPayments      Float      @default(0)
  cardPayments      Float      @default(0)
  pixPayments       Float      @default(0)
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  shop              Barbershop @relation(fields: [shopId], references: [id])

  @@unique([shopId, date])
  @@index([shopId, date])
  @@map("daily_cash_flow")
}

model ServiceProductAnalytics {
  id           String     @id @default(uuid())
  shopId       String
  serviceId    String?
  productId    String?
  periodStart  DateTime   @db.Date
  periodEnd    DateTime   @db.Date
  totalSold    Int        @default(0)
  totalRevenue Float      @default(0)
  totalCost    Float?
  totalProfit  Float?
  ranking      Int?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  product      Product?   @relation(fields: [productId], references: [id])
  service      Service?   @relation(fields: [serviceId], references: [id])
  shop         Barbershop @relation(fields: [shopId], references: [id])

  @@unique([shopId, serviceId, productId, periodStart, periodEnd])
  @@index([shopId, periodStart, periodEnd])
  @@map("service_product_analytics")
}

model BarbershopModule {
  id         String     @id @default(uuid())
  shopId     String
  moduleType ModuleType
  enabled    Boolean    @default(true)
  enabledAt  DateTime?
  disabledAt DateTime?
  enabledBy  String?
  disabledBy String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  shop       Barbershop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@unique([shopId, moduleType])
  @@index([shopId, enabled])
  @@map("barbershop_modules")
}

model BarbershopHeroSettings {
  id              String     @id @default(uuid())
  shopId          String     @unique
  title           String     @default("Estilo & Tradição")
  subtitle        String     @default("Excelência no atendimento")
  backgroundImage String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  shop            Barbershop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@map("barbershop_hero_settings")
}

model BarbershopPlansContent {
  id            String     @id @default(uuid())
  shopId        String     @unique
  heroTitle     String     @default("Assinaturas")
  heroSubtitle  String     @default("Faça parte do clube e tenha benefícios exclusivos")
  benefit1Title String     @default("Economia Real")
  benefit1Text  String?
  benefit2Title String     @default("Sempre Alinhado")
  benefit2Text  String?
  benefit3Title String     @default("Sem Fidelidade")
  benefit3Text  String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  shop          Barbershop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@map("barbershop_plans_content")
}

model BarbershopFaq {
  id           String     @id @default(uuid())
  shopId       String
  question     String
  answer       String
  displayOrder Int        @default(0)
  active       Boolean    @default(true)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  shop         Barbershop @relation(fields: [shopId], references: [id], onDelete: Cascade)

  @@index([shopId])
  @@map("barbershop_faq")
}

model Invoice {
  id            String         @id @default(uuid())
  shopId        String
  clientId      String?
  amount        Float
  status        InvoiceStatus  @default(PENDING)
  type          InvoiceType
  paymentMethod PaymentMethod?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  appointmentId String?        @unique
  barberId      String?
  cancelledAt   DateTime?
  clientName    String
  description   String?
  paidAt        DateTime?
  items         InvoiceItem[]
  appointment   Appointment?   @relation(fields: [appointmentId], references: [id])
  barber        Barber?        @relation(fields: [barberId], references: [id])
  client        Client?        @relation(fields: [clientId], references: [id])
  shop          Barbershop     @relation(fields: [shopId], references: [id])

  @@index([shopId, status])
  @@index([shopId, createdAt])
  @@index([clientId])
  @@index([barberId])
  @@map("invoices")
}

model InvoiceItem {
  id        String      @id @default(uuid())
  invoiceId String
  type      InvoiceType
  serviceId String?
  productId String?
  planId    String?
  name      String
  price     Float
  quantity  Int         @default(1)
  createdAt DateTime    @default(now())
  invoice   Invoice     @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  plan      Plan?       @relation(fields: [planId], references: [id])
  product   Product?    @relation(fields: [productId], references: [id])
  service   Service?    @relation(fields: [serviceId], references: [id])

  @@index([invoiceId])
  @@map("invoice_items")
}

model FixedCost {
  id        String        @id @default(uuid())
  shopId    String
  name      String
  value     Float
  category  CostCategory
  frequency CostFrequency @default(MONTHLY)
  active    Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  shop      Barbershop    @relation(fields: [shopId], references: [id])

  @@index([shopId, active])
  @@map("fixed_costs")
}

model NotificationLog {
  id            String       @id @default(uuid())
  shopId        String
  clientId      String?
  barberId      String?
  appointmentId String?
  type          String
  status        String
  errorMessage  String?
  sentAt        DateTime?
  createdAt     DateTime     @default(now())
  appointment   Appointment? @relation(fields: [appointmentId], references: [id])
  barber        Barber?      @relation(fields: [barberId], references: [id])
  client        Client?      @relation(fields: [clientId], references: [id])
  shop          Barbershop   @relation(fields: [shopId], references: [id])

  @@index([shopId])
  @@index([clientId])
  @@index([appointmentId])
  @@index([type])
  @@map("notification_logs")
}

model BarbershopAsset {
  id               String     @id @default(uuid())
  shopId           String
  name             String
  description      String?
  purchaseDate     DateTime   @db.Date
  purchasePrice    Float
  usefulLifeMonths Int        @default(24)
  isActive         Boolean    @default(true)
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  shop             Barbershop @relation(fields: [shopId], references: [id])

  @@index([shopId])
  @@index([isActive])
  @@map("barbershops_assets")
}

model SupplyItem {
  id          String         @id @default(uuid())
  shopId      String
  name        String
  description String?
  category    String?
  unit        SupplyUnitType @default(UNIT)
  quantity    Float          @default(0)
  minQuantity Float?         @default(0)
  unitCost    Float?
  totalCost   Float?
  isActive    Boolean        @default(true)
  notes       String?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  shop        Barbershop     @relation(fields: [shopId], references: [id])

  @@index([shopId])
  @@index([shopId, category])
  @@index([isActive])
  @@map("supply_items")
}

model UserShopAccess {
  id        String     @id @default(uuid())
  userId    String
  shopId    String
  role      UserRole   @default(ADMIN)
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  shop      Barbershop @relation(fields: [shopId], references: [id], onDelete: Cascade)
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, shopId])
  @@index([userId])
  @@index([shopId])
  @@index([isActive])
  @@map("user_shop_access")
}

