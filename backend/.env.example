# Exemplo de variáveis de ambiente para Backend_Barberpro
# COPIE ESTE ARQUIVO PARA .env E CONFIGURE COM VALORES REAIS!

# Database (MUDE A SENHA!)
DATABASE_URL="postgresql://postgres:YOUR_STRONG_PASSWORD_HERE@localhost:5432/barberpro"
POSTGRES_USER=postgres
POSTGRES_PASSWORD=YOUR_STRONG_PASSWORD_HERE
POSTGRES_DB=barberpro

# JWT Secrets (GERE SEGREDOS FORTES!)
# Gere com: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="GENERATE_A_STRONG_RANDOM_SECRET_HERE"
JWT_REFRESH_SECRET="GENERATE_ANOTHER_STRONG_RANDOM_SECRET_HERE"

# Application
NODE_ENV=development
PORT=3000
FRONTEND_URL="http://localhost:3000"
