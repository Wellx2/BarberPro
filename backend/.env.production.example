# Database
DATABASE_URL="postgresql://user:password@host:5432/klypbarber"
DIRECT_URL="postgresql://user:password@host:5432/klypbarber"


# JWT Secrets (MUDE ESTES VALORES EM PRODUÇÃO!)
JWT_SECRET="GERAR_NOVO_SECRET_LONG_E_ALEATORIO"
JWT_REFRESH_SECRET="GERAR_NOVO_REFRESH_SECRET_LONG_E_ALEATORIO"

# Application
NODE_ENV="production"
PORT=3000
FRONTEND_URL="https://www.klypbarber.com.br"

# Google OAuth
GOOGLE_CLIENT_ID="sua-id-google.apps.googleusercontent.com"
