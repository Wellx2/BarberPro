# Database (Staging)
DATABASE_URL="postgresql://user:password@host:5432/klypbarber_staging"

# JWT Secrets (MUDE ESTES VALORES!)
JWT_SECRET="GERAR_NOVO_SECRET_STAGING"
JWT_REFRESH_SECRET="GERAR_NOVO_REFRESH_STAGING"

# Application
NODE_ENV="staging"
PORT=3000
FRONTEND_URL="https://staging.klypbarber.com.br"

# Google OAuth
GOOGLE_CLIENT_ID="id-staging.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="secret-staging"
GOOGLE_CALLBACK_URL="https://staging.klypbarber.com.br/api/auth/google/callback"
